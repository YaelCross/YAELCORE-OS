# ChatGPT (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_clave_de_openai_aqui
OPENAI_MODEL=gpt-5

# Claude (Anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=tu_clave_de_anthropic_aqui
CLAUDE_MODEL=claude-sonnet-5-5

# Modo inicial del cerebro: equipo | claude | chatgpt
JARVIS_MODO=equipo

# Centro de Mando (interfaz del equipo) — python centro_mando.py
# Puerto y PIN de acceso de cada integrante (CENTRO_PIN_<NOMBRE>).
# Si un integrante no tiene PIN, puede entrar sin contraseña.
CENTRO_PUERTO=8765
CENTRO_PIN_YAEL=cambia_este_pin
CENTRO_PIN_FRIDA=
CENTRO_PIN_EFREN=
CENTRO_PIN_NOVA=

# --- Meta Ads (solo lectura) ---
# Token de un usuario del sistema con permiso ads_read (ver README)
META_ACCESS_TOKEN=
# nombre:id de cada cuenta publicitaria, separados por coma
META_AD_ACCOUNTS=Movilera:289256139
META_CTR_MINIMO=0.8
META_FRECUENCIA_MAX=3.5

# WhatsApp Business Cloud (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=tu_token_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
# Destinatario por defecto, formato internacional sin "+" (ej. 5215512345678)
WHATSAPP_DEFAULT_TO=
WHATSAPP_API_VERSION=v23.0
